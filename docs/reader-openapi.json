  "components": {
    "securitySchemes": {
      "IntegrationBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque integration credential",
        "description": "Credencial delegada exclusiva. No es una clave publicable ni una sesión del navegador. Alcances obligatorios en servidor; tokens rechazados fuera de la API delegada."
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string"
          },
          "snapshotId": {
            "type": "string"
          },
          "calculatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "calculationVersion": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "requestId",
          "snapshotId",
          "calculatedAt",
          "calculationVersion",
          "warnings"
        ]
      },
      "Person": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "archived"
        ]
      },
      "Card": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string"
          },
          "bank": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "archived"
        ]
      },
      "Purchase": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "personId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "cardId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string"
          },
          "amountCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000000
          },
          "currency": {
            "const": "MXN"
          },
          "kind": {
            "enum": [
              "normal",
              "msi",
              "recurring"
            ]
          },
          "terms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "startMonth": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(19|20|21)[0-9]{2}-(0[1-9]|1[0-2])$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "personId",
          "cardId",
          "description",
          "amountCents",
          "currency",
          "kind",
          "terms",
          "startMonth"
        ]
      },
      "Installment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "purchaseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "personId": {
            "type": "string",
            "minLength": 1,
